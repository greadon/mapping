HOST=127.0.0.1
PORT=8091
# Existing StageMode Control server; HTTPS is required except on loopback.
STAGEMODE_URL=https://control.stagemode.io
# Set to the public HTTPS origin when placing this app behind a reverse proxy.
# PUBLIC_ORIGIN=https://maps.example.com

# Optional: enables what3words addresses in marker details.
WHAT3WORDS_API_KEY=
